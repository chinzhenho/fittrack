// Cloudflare Workers static assets: serves the built website (apps/web/dist).
// No server code; unknown paths fall back to index.html for client-side routes.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./apps/web/dist",
    "not_found_handling": "single-page-application",
  },
}
